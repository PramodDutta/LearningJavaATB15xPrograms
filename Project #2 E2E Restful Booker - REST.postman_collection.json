    {
      "name": "Create Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test(\"Response has JSON content type\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Response body is valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test(\"Response contains token property\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"token\");",
              "});",
              "",
              "pm.test(\"Token is a non-empty string\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.be.a(\"string\");",
              "    pm.expect(jsonData.token).to.not.be.empty;",
              "});",
              "",
              "pm.test(\"Token has expected format\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.match(/^[a-f0-9]+$/);",
              "});",
              "",
              "pm.test(\"No extra properties in response\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(Object.keys(jsonData)).to.have.lengthOf(1);",
              "    pm.expect(Object.keys(jsonData)[0]).to.equal(\"token\");",
              "});",
              "",
              "pm.test(\"Store token as collection variable\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set(\"token\", jsonData.token);",
              "    pm.expect(pm.collectionVariables.get(\"token\")).to.equal(jsonData.token);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
