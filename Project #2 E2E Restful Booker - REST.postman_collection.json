              "});",
              "",
              "pm.test(\"Response body is a JSON array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Array is not empty\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Each item in the array has a bookingid property\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.forEach(function (item) {",
              "        pm.expect(item).to.have.property(\"bookingid\");",
              "    });",
              "});",
              "",
              "pm.test(\"Each bookingid is a number\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.forEach(function (item) {",
              "        pm.expect(item.bookingid).to.be.a(\"number\");",
              "    });",
              "});",
              ""
